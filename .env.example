# Copy to .env (git-ignored) and adjust:  cp .env.example .env

# REQUIRED. HMAC key that signs the JWTs (min. 32 characters).
# Generate a real one with:  openssl rand -hex 32
# The value below is for local development only.
JWT_SECRET=dev-only-change-me-dev-only-change-me-0123456789

# NOTE: not applied yet. JwtService uses fixed lifetimes (access token 10 h, refresh token 7 days);
# the `jwt.expiration` property is defined but nothing reads it.
# JWT_EXPIRATION=86400000

# `Secure` flag of the access_token cookie. Keep false for http://localhost, true behind HTTPS.
COOKIE_SECURE=false

# Database. Defaults match the `db` service of docker-compose.yml;
# point SPRING_DATASOURCE_DB_HOST at your server to use an external PostgreSQL instead.
# SPRING_DATASOURCE_DB_HOST=db
# SPRING_DATASOURCE_DB_PORT=5432
# SPRING_DATASOURCE_DB_NAME=chaoticteamdb
# SPRING_DATASOURCE_USERNAME=user
# SPRING_DATASOURCE_PASSWORD=password
